# ============================================================
# App
# ============================================================
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ============================================================
# Database (XAMPP default on Windows: root / no password)
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmacy_chain

# ============================================================
# Auth
# Generate a long random string, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# ============================================================
JWT_SECRET=replace_me_with_a_random_string_at_least_32_characters_long
# Short session default — pharmacy terminals are often shared. Lengthen only
# once you add a refresh-token flow.
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# ============================================================
# Rate limiting (requests per window per IP)
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ============================================================
# Simulated integrations (never real APIs in this competition build)
# ============================================================
SMS_DRIVER=mock
PAYMENT_DRIVER=mock
